set_option maxHeartbeats 0 in
set_option maxRecDepth 10000 in
theorem certified : Certified rows stages 50 := by
  apply (certified_iff _ _ _).2
  decide +kernel

theorem covers_seed : M*(a₀+1) ≤ room rows selected := by decide +kernel

theorem earlier : (B+1)*461814143304116035103818818074847139530008111 < A*747230980351474411985551361801500529348765790 := by
  decide +kernel

private theorem endpoints :
    (rows 0).a=a₀ ∧ (rows 50).a=A ∧ (rows 50).b=B ∧ A≤B := by decide +kernel

private theorem indices : ∀ i ∈ selected, i ≤ 50 := by
  simp [selected]

set_option maxRecDepth 10000 in
private theorem constants :
    cost selected < C ∧
    (2^50*C*multiplier stages 50:ℕ) ≤ (C-cost selected)*D := by
  decide +kernel

private theorem combine {fa fA delta : ℤ} {T K : ℕ} (pos : T < C) (nonneg : 0 ≤ delta)
    (initial : ((C:ℤ)-(T:ℤ))*fa ≤ (T:ℤ)*(K:ℤ)*delta)
    (final : fA ≤ (2:ℤ)^50*(fa+(K:ℤ)*delta))
    (coef : 2^50*C*K ≤ (C-T)*D) : fA ≤ (D:ℤ)*delta := by
  have hpos : 0 < (C:ℤ)-(T:ℤ) := sub_pos.mpr (by exact_mod_cast pos)
  have growth : (2:ℤ)^50*(C:ℤ)*(K:ℤ) ≤ ((C:ℤ)-(T:ℤ))*(D:ℤ) := by
    exact_mod_cast (show ((2^50*C*K:ℕ):ℤ) ≤ ((C:ℤ)-(T:ℤ))*(D:ℤ) by
      simpa [Nat.cast_sub pos.le] using (Int.ofNat_le.mpr coef))
  apply (mul_le_mul_iff_right₀ hpos).mp
  calc
    ((C:ℤ)-(T:ℤ))*fA ≤ ((C:ℤ)-(T:ℤ))*((2:ℤ)^50*(fa+(K:ℤ)*delta)) :=
      mul_le_mul_of_nonneg_left final hpos.le
    _ = (2:ℤ)^50*(((C:ℤ)-(T:ℤ))*fa + ((C:ℤ)-(T:ℤ))*((K:ℤ)*delta)) := by ring
    _ ≤ (2:ℤ)^50*((T:ℤ)*(K:ℤ)*delta + ((C:ℤ)-(T:ℤ))*((K:ℤ)*delta)) :=
      mul_le_mul_of_nonneg_left (add_le_add_left initial _) (by positivity)
    _ = ((2:ℤ)^50*(C:ℤ)*(K:ℤ))*delta := by ring
    _ ≤ (((C:ℤ)-(T:ℤ))*(D:ℤ))*delta := mul_le_mul_of_nonneg_right growth nonneg
    _ = ((C:ℤ)-(T:ℤ))*((D:ℤ)*delta) := by ring

variable (P : ℕ → ℤ) (mono : Monotone P) (sub : ∀ x y, P (x+y) ≤ P x+P y)
    (glue : ∀ x y, y ≤ x → P x+P y ≤ P (2*x+y))

include mono sub glue in
theorem abstract_growth_room (seed : (C:ℤ)*P a₀ ≤ P (room rows selected)) :
    P A ≤ (D:ℤ)*(P B-P A) := by
  obtain ⟨start,left,right,ab⟩ := endpoints
  have endgap : gap P (rows 50) = P B-P A := by rw [gap,left,right]
  have g := charged_seed P mono sub glue rows stages 50 certified selected indices
    (le_refl (room rows selected)) (by simpa only [start] using seed)
  have f := right_from_uniform P sub rows 50 _
    (fun i h => congrArg Row.a (certified i h).1)
    (uniform_gap P mono sub glue rows stages 50 certified) 50 (by decide)
  rw [start,endgap] at g
  rw [start,endgap,right] at f
  exact combine constants.1 (sub_nonneg.mpr (mono ab)) g ((mono ab).trans f) constants.2

include mono sub glue in
theorem abstract_growth (seed : (C:ℤ)*P a₀ ≤ P (M*a₀)) : P A ≤ (D:ℤ)*(P B-P A) := by
  apply abstract_growth_room P mono sub glue
  exact seed.trans (mono ((Nat.mul_le_mul_left M (Nat.le_succ a₀)).trans covers_seed))

